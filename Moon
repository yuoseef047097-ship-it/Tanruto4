			(State.FlyUp and 1 or 0)
			-
			(State.FlyDown and 1 or 0)

		FlyVelocity.VectorVelocity=
			Vector3.new(
				movement.X*
				Values.FlySpeed,

				vertical*
				Values.FlySpeed,

				movement.Z*
				Values.FlySpeed
			)

		local look=
			Camera.CFrame.LookVector

		local flat=
			Vector3.new(
				look.X,
				0,
				look.Z
			)

		if
			flat.Magnitude>.05 and
			FlyOrientation
		then
			FlyOrientation.CFrame=
				CFrame.lookAt(
					Root.Position,
					Root.Position+
					flat.Unit
