Connect(
	RunService.Heartbeat,
	function()
		for _,target in ipairs(
			Players:GetPlayers()
		) do
			if
				ShouldESP(target) and
				not ESPObjects[target]
			then
				AddESP(target)

			elseif
				not ShouldESP(target) and
				ESPObjects[target]
			then
				RemoveESP(target)
			end
		end

		for target,data in pairs(
			ESPObjects
		) do
			if
				not target.Parent or
				not data.Root.Parent
			then
				RemoveESP(target)
				continue
			end

			local distance=
				Root and
				(
					Root.Position-
					data.Root.Position
				).Magnitude or
				0

			local visible=
				distance<=
				Values.ESPDistance

			data.Gui.Enabled=
				visible

			data.Highlight.Enabled=
				visible

			if visible then
				local lines={}

				if State.ESPNames then
					table.insert(
						lines,
						target.DisplayName..
						" @"..
						target.Name
					)
				end

				if State.ESPHealth then
					table.insert(
						lines,
						"HP "..
						math.floor(
							data.Humanoid.Health
						)..
						"/"..
						math.floor(
							data.Humanoid.MaxHealth
						)
					)
				end

				if State.ESPDistance then
					table.insert(
						lines,
						math.floor(
							distance
						)..
						" studs"
					)
				end

				data.Label.Text=
					table.concat(
						lines,
						"\n"
					)
			end
		end
	end
)

