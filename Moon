local function Slider(
	parent,
	text,
	min,
	max,
	default,
	callback,
	suffix
)
	local Holder=
		Instance.new("Frame")

	Holder.Size=
		UDim2.new(
			1,
			-2,
			0,
			62
		)

	Holder.BackgroundColor3=
		Theme.Surface2

	Holder.BorderSizePixel=0
	Holder.Parent=parent

	Corner(Holder,10)

	local Label=
		Instance.new("TextLabel")

	Label.Size=
		UDim2.new(
			1,
			-20,
			0,
			29
		)

	Label.Position=
		UDim2.fromOffset(
			10,
			2
		)

	Label.BackgroundTransparency=1

	Label.TextColor3=
		Theme.Text

	Label.TextSize=
		FONT.Slider

	Label.Font=
		Enum.Font.GothamMedium

	Label.TextXAlignment=
		Enum.TextXAlignment.Left

	Label.Parent=Holder

	local Bar=
		Instance.new("Frame")

	Bar.Size=
		UDim2.new(
			1,
			-24,
			0,
			8
		)

	Bar.Position=
		UDim2.new(
			0,
			12,
			1,
			-18
		)

	Bar.BackgroundColor3=
		Theme.Surface3

	Bar.BorderSizePixel=0
	Bar.Active=true
	Bar.Parent=Holder

	Corner(Bar,6)

	local Fill=
		Instance.new("Frame")

	Fill.BackgroundColor3=
		Theme.Accent2

	Fill.BorderSizePixel=0
	Fill.Parent=Bar

	Corner(Fill,6)

	local Value=default

	local function Set(value)
		Value=
			math.floor(
				Clamp(
					value,
					min,
					max
				)+.5
			)

		local percent=
			(Value-min)/
			(max-min)

		Fill.Size=
			UDim2.fromScale(
				percent,
				1
			)

		Label.Text=
			text..
			"   "..
			Value..
			(suffix or "")

		callback(Value)
	end

	local Dragging=false
	local ActiveInput

	local function Update(input)
		Set(
			min+
			(max-min)*
			Clamp(
				(
					input.Position.X-
					Bar.AbsolutePosition.X
				)/
				Bar.AbsoluteSize.X,
				0,
				1
			)
		)
	end

	Connect(
		Bar.InputBegan,
		function(input)
			if
				input.UserInputType==
					Enum.UserInputType.Touch
				or
				input.UserInputType==
					Enum.UserInputType.MouseButton1
			then
				Dragging=true
				ActiveInput=input
				Update(input)
			end
		end
	)

	Connect(
		UIS.InputChanged,
		function(input)
			if not Dragging then
				return
			end

			local valid=
				input==ActiveInput or
				(
					ActiveInput and
					ActiveInput.UserInputType==
						Enum.UserInputType.MouseButton1 and
					input.UserInputType==
						Enum.UserInputType.MouseMovement
				)

			if valid then
				Update(input)
			end
		end
	)

	Connect(
		UIS.InputEnded,
		function(input)
			if input==ActiveInput then
				Dragging=false
				ActiveInput=nil
			end
		end
	)

	Set(default)

	return {
		Set=Set,
		Get=function()
			return Value
		end
	}
end

