local ESPObjects={}

local function RemoveESP(target)
	local data=
		ESPObjects[target]

	if data then
		if data.Highlight then
			data.Highlight:Destroy()
		end

		if data.Gui then
			data.Gui:Destroy()
		end

		ESPObjects[target]=nil
	end
end

local function ShouldESP(target)
	if
		target==Player or
		not target.Character
	then
		return false
	end

	if
		State.TeamCheck and
		Player.Team and
		target.Team and
		Player.Team==target.Team
	then
		return false
	end

	return
		State.ESP or
		(
			State.SelectedESP and
			target==
				State.SelectedPlayer
		)
end

local function AddESP(target)
	RemoveESP(target)

	if not ShouldESP(target) then
		return
	end

	local targetRoot=
		target.Character:
		FindFirstChild(
			"HumanoidRootPart"
		)

	local targetHumanoid=
		target.Character:
		FindFirstChildOfClass(
			"Humanoid"
		)

	if
		not targetRoot or
		not targetHumanoid
	then
		return
	end

	local Highlight=
		Instance.new("Highlight")

	Highlight.Adornee=
		target.Character

	Highlight.FillColor=
		Theme.Accent

	Highlight.FillTransparency=.72

	Highlight.OutlineColor=
		Theme.Accent2

	Highlight.DepthMode=
		Enum.HighlightDepthMode.AlwaysOnTop

	Highlight.Parent=
		target.Character

	local Gui=
		Instance.new("BillboardGui")

	Gui.Size=
		UDim2.fromOffset(
			190,
			80
		)

	Gui.StudsOffset=
		Vector3.new(
			0,
			3.2,
			0
		)

	Gui.AlwaysOnTop=true
	Gui.Adornee=targetRoot
	Gui.Parent=targetRoot

	local Label=
		Instance.new("TextLabel")

	Label.Size=
		UDim2.fromScale(1,1)

	Label.BackgroundTransparency=1

	Label.TextColor3=
		Theme.Text

	Label.TextStrokeTransparency=.15

	Label.TextSize=
		FONT.ESP

	Label.Font=
		Enum.Font.GothamBold

	Label.Parent=Gui

	ESPObjects[target]={
		Highlight=Highlight,
		Gui=Gui,
		Label=Label,
		Root=targetRoot,
		Humanoid=targetHumanoid
	}
end

local function RefreshESP()
	local old={}

	for target in pairs(
		ESPObjects
	) do
		table.insert(
			old,
			target
		)
	end

	for _,target in ipairs(old) do
		RemoveESP(target)
	end

	for _,target in ipairs(
		Players:GetPlayers()
	) do
		if ShouldESP(target) then
			AddESP(target)
		end
	end
end

