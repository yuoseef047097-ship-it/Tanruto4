local function CreateSharingan(parent,size)
	local Eye=Instance.new("Frame")
	Eye.Size=UDim2.fromOffset(
		size,
		size
	)
	Eye.BackgroundColor3=Theme.Accent
	Eye.BorderSizePixel=0
	Eye.Parent=parent

	Circle(Eye)

	Stroke(
		Eye,
		Theme.Accent2,
		1.2,
		.15
	)

	local Ring=Instance.new("Frame")
	Ring.Size=UDim2.fromScale(.72,.72)
	Ring.AnchorPoint=Vector2.new(.5,.5)
	Ring.Position=UDim2.fromScale(.5,.5)
	Ring.BackgroundTransparency=1
	Ring.Parent=Eye

	Circle(Ring)

	Stroke(
		Ring,
		Color3.fromRGB(6,3,5),
		2
	)

	local Pupil=Instance.new("Frame")
	Pupil.Size=UDim2.fromScale(.18,.18)
	Pupil.AnchorPoint=Vector2.new(.5,.5)
	Pupil.Position=UDim2.fromScale(.5,.5)
	Pupil.BackgroundColor3=
		Color3.fromRGB(3,3,5)
	Pupil.BorderSizePixel=0
	Pupil.Parent=Eye

	Circle(Pupil)

	for i=1,3 do
		local angle=
			math.rad(
				(i-1)*120-90
			)

		local dot=Instance.new("Frame")

		dot.Size=UDim2.fromScale(
			.12,
			.12
		)

		dot.AnchorPoint=
			Vector2.new(.5,.5)

		dot.Position=UDim2.new(
			.5,
			math.cos(angle)*size*.27,
			.5,
			math.sin(angle)*size*.27
		)

		dot.BackgroundColor3=
			Color3.fromRGB(5,3,5)

		dot.BorderSizePixel=0
		dot.Parent=Eye

		Circle(dot)
	end

	return Eye
end

