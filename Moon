local DashBusy=false

local function Dash()
	if
		DashBusy or
		not Root or
		not Humanoid
	then
		return
	end

	local direction=
		Humanoid.MoveDirection

	if
		direction.Magnitude<.1 and
		Camera
	then
		local look=
			Camera.CFrame.LookVector

		direction=
			Vector3.new(
				look.X,
				0,
				look.Z
			)
	end

	if direction.Magnitude<.1 then
		return
	end

	DashBusy=true
	direction=direction.Unit

	Root.AssemblyLinearVelocity=
		Vector3.new(
			direction.X*
			Values.DashPower,

			Root.AssemblyLinearVelocity.Y,

			direction.Z*
			Values.DashPower
		)

	task.delay(
		Values.DashCooldown,
		function()
			DashBusy=false
		end
	)
end

