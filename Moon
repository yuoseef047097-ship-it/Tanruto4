local function UpdateResponsive()
	if not Camera then
		return
	end

	local viewport=Camera.ViewportSize

	ResponsiveFactor=Clamp(
		math.min(
			viewport.X/390,
			viewport.Y/470
		),
		.92,
		1
	)

	ApplyMainScale()
end

