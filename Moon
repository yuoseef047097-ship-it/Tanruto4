local function ShowPage(name)
	for pageName,page in pairs(Pages) do
		page.Visible=
			pageName==name
	end

	for tabName,button in pairs(TabButtons) do
		local selected=
			tabName==name

		button.BackgroundColor3=
			selected and
			Theme.AccentDark or
			Theme.Surface2

		button.TextColor3=
			selected and
			Theme.Text or
			Theme.Muted
	end
end

