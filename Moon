local function RemoveQuick(id)
	local data=
		QuickButtons[id]

	if data then
		if data.Button then
			data.Button:Destroy()
		end

		QuickButtons[id]=nil
	end
end

local function UpdateQuickSettings()
	for _,data in pairs(QuickButtons) do
		data.Button.Size=
			UDim2.fromOffset(
				State.QuickSize,
				State.QuickSize
			)

		data.Button.BackgroundTransparency=
			State.QuickTransparency
	end
end

local function CreateQuick(
	id,
	text,
	callback,
	position
)
	if not id or QuickButtons[id] then
		return
	end

	local Button=
		Instance.new("TextButton")

	Button.Size=
		UDim2.fromOffset(
			State.QuickSize,
			State.QuickSize
		)

	Button.Position=
		position or
		UDim2.new(
			1,
			-70,
			.5,
			-25
		)

	Button.BackgroundColor3=
		Theme.Surface

	Button.BackgroundTransparency=
		State.QuickTransparency

	Button.BorderSizePixel=0
	Button.Text=text
	Button.TextColor3=Theme.Text
	Button.TextSize=FONT.Quick
	Button.TextWrapped=true
	Button.Font=Enum.Font.GothamBold
	Button.AutoButtonColor=false
	Button.Active=true
	Button.ZIndex=80
	Button.Parent=QuickHolder

	Circle(Button)

	Stroke(
		Button,
		Theme.Accent2,
		1.2,
		.1
	)

	local Dragging=false
	local Moved=false

	local ActiveInput
	local Start
	local StartPosition

	Connect(
		Button.InputBegan,
		function(input)
			if
				input.UserInputType~=
					Enum.UserInputType.Touch
				and
				input.UserInputType~=
					Enum.UserInputType.MouseButton1
			then
				return
			end

			if State.QuickLocked then
				callback()
				return
			end

			Dragging=true
			Moved=false

			ActiveInput=input
			Start=input.Position
			StartPosition=Button.Position
		end
	)

	Connect(
		UIS.InputChanged,
		function(input)
			if not Dragging then
				return
			end

			local valid=
				input==ActiveInput or
				(
					ActiveInput and
					ActiveInput.UserInputType==
						Enum.UserInputType.MouseButton1 and
					input.UserInputType==
						Enum.UserInputType.MouseMovement
				)

			if not valid then
				return
			end

			local delta=
				input.Position-Start

			if delta.Magnitude>6 then
				Moved=true
			end

			Button.Position=
				UDim2.new(
					StartPosition.X.Scale,
					StartPosition.X.Offset+delta.X,
					StartPosition.Y.Scale,
					StartPosition.Y.Offset+delta.Y
				)
		end
	)

	Connect(
		UIS.InputEnded,
		function(input)
			if input~=ActiveInput then
				return
			end

			Dragging=false
			ActiveInput=nil

			if not Moved then
				callback()
			end
		end
	)

	QuickButtons[id]={
		Button=Button,
		Callback=callback
	}

	return Button
end

local function ActionButton(
