local NoclipOriginal={}

local function RestoreNoclip()
	for part,value in pairs(NoclipOriginal) do
		if part and part.Parent then
			part.CanCollide=value
		end
	end

	table.clear(NoclipOriginal)
end

Connect(
	RunService.Stepped,
	function()
		if
			State.Noclip and
			Character
		then
			for _,object in ipairs(
				Character:GetDescendants()
			) do
				if object:IsA("BasePart") then
					if NoclipOriginal[object]==nil then
						NoclipOriginal[object]=
							object.CanCollide
					end

					object.CanCollide=false
				end
			end
		else
			RestoreNoclip()
		end
	end
)

local WallParams=
	RaycastParams.new()

WallParams.FilterType=
	Enum.RaycastFilterType.Exclude

WallParams.IgnoreWater=true

local LastWallHop=0

Connect(
	UIS.JumpRequest,
	function()
		if
			not State.WallHop or
			not Root or
			not Character or
			os.clock()-LastWallHop<.18
		then
			return
		end

		WallParams.FilterDescendantsInstances={
			Character
		}

		for _,direction in ipairs({
			Root.CFrame.RightVector,
			-Root.CFrame.RightVector,
			Root.CFrame.LookVector,
			-Root.CFrame.LookVector
		}) do
			local result=
				workspace:Raycast(
					Root.Position,
					direction*4,
					WallParams
				)

			if result then
				LastWallHop=
					os.clock()

				Root.AssemblyLinearVelocity=
					result.Normal*
					Values.WallPower+
					Vector3.new(
						0,
						Values.WallJump,
						0
					)

				break
			end
		end
	end
)

