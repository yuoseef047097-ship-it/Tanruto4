	Button.Font=
		Enum.Font.GothamMedium

	Button.TextXAlignment=
		Enum.TextXAlignment.Left

	Button.AutoButtonColor=false
	Button.Active=true
	Button.Parent=parent

	Corner(Button,10)

	local Pin=
		Instance.new("TextLabel")

	Pin.Size=
		UDim2.fromOffset(
			25,
			42
		)

	Pin.Position=
		UDim2.new(
			1,
			-28,
			0,
			0
		)

	Pin.BackgroundTransparency=1

	Pin.Text=
		id and
		"◆" or
		""

	Pin.TextColor3=
		Theme.Accent2

	Pin.TextSize=14
	Pin.Font=Enum.Font.GothamBold
	Pin.Parent=Button

	local Pressing=false
	local LongPress=false

	local ActiveInput
	local Ghost

	Connect(
		Button.InputBegan,
		function(input)
			if
				input.UserInputType~=
					Enum.UserInputType.Touch
				and
				input.UserInputType~=
					Enum.UserInputType.MouseButton1
			then
				return
			end

			Pressing=true
			LongPress=false
			ActiveInput=input

			task.delay(
				CONFIG.LongPress,
				function()
					if
						not Pressing or
						ActiveInput~=input or
						not id
					then
						return
					end

					LongPress=true

					Ghost=
						Instance.new(
							"TextLabel"
						)

					Ghost.Size=
						UDim2.fromOffset(
							State.QuickSize,
							State.QuickSize
						)

					Ghost.AnchorPoint=
						Vector2.new(.5,.5)

					Ghost.Position=
						UDim2.fromOffset(
							input.Position.X,
							input.Position.Y
						)

					Ghost.BackgroundColor3=
						Theme.AccentDark

					Ghost.Text=
						quickText

					Ghost.TextColor3=
						Theme.Text

					Ghost.TextSize=
						FONT.Quick

					Ghost.Font=
						Enum.Font.GothamBold

					Ghost.ZIndex=150
					Ghost.Parent=GUI

					Circle(Ghost)
				end
			)
		end
	)

	Connect(
		UIS.InputChanged,
		function(input)
			if
				Pressing and
				LongPress and
				Ghost
			then
				local valid=
					input==ActiveInput or
					(
						ActiveInput and
						ActiveInput.UserInputType==
							Enum.UserInputType.MouseButton1 and
						input.UserInputType==
							Enum.UserInputType.MouseMovement
					)

				if valid then
					Ghost.Position=
						UDim2.fromOffset(
							input.Position.X,
							input.Position.Y
						)
				end
			end
		end
	)

	Connect(
		UIS.InputEnded,
		function(input)
			if input~=ActiveInput then
				return
			end

			Pressing=false
			ActiveInput=nil

			if LongPress then
				local p=
					input.Position

				local mp=
					Main.AbsolutePosition

				local ms=
					Main.AbsoluteSize

				if
					p.X<mp.X or
					p.X>mp.X+ms.X or
					p.Y<mp.Y or
					p.Y>mp.Y+ms.Y
				then
					CreateQuick(
						id,
						quickText,
						callback,
						UDim2.fromOffset(
							p.X-State.QuickSize/2,
							p.Y-State.QuickSize/2
						)
					)
				end

				if Ghost then
					Ghost:Destroy()
					Ghost=nil
				end
			else
				callback()
			end
		end
	)

	return Button
end

