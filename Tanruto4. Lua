local function applyTheme(name)
	if not themes[name] then return end

	currentTheme=name
	local color=themes[name]

	title.BackgroundColor3=color
	mini.BackgroundColor3=color
	fs.Color=color

	for _,s in ipairs(allSections) do
		if s and s.Parent then
			s.BackgroundColor3=color
		end
	end

	for _,b in ipairs(allButtons) do
		if b and b.Parent then
			b.BackgroundColor3=color
		end
	end

	redThemeButton.BackgroundColor3=(name=="Red" and color) or Color3.fromRGB(35,37,45)
	yellowThemeButton.BackgroundColor3=(name=="Yellow" and color) or Color3.fromRGB(35,37,45)
	pinkThemeButton.BackgroundColor3=(name=="Pink" and color) or Color3.fromRGB(35,37,45)
	blueThemeButton.BackgroundColor3=(name=="Blue" and color) or Color3.fromRGB(35,37,45)
	greenThemeButton.BackgroundColor3=(name=="Green" and color) or Color3.fromRGB(35,37,45)
end

local function applyTransparency()
	frame.BackgroundTransparency=uiTransparency

	for _,b in ipairs(allButtons) do
		if b and b.Parent then
			b.BackgroundTransparency=uiTransparency
		end
	end

	for _,s in ipairs(allSections) do
		if s and s.Parent then
			s.BackgroundTransparency=uiTransparency
		end
	end
end

