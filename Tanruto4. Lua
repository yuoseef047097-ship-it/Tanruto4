local function Cleanup()
	if Cleaned then
		return
	end

	Cleaned = true
	Alive = false

	StopFly()

	State.Noclip = false
	UpdateNoclip()

	RemoveTPTool()

	for player in pairs(ESPObjects) do
		RemoveESP(player)
	end

	SafeDestroy(TracerPart)
	DisconnectAll()

	pcall(function()
		if GUI and GUI.Parent then
			GUI:Destroy()
		end
	end)
end

_G[CLEANUP_KEY] = Cleanup

