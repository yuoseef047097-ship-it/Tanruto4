local function refreshPlayers()

	for _, child in ipairs(playersScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local list = {}

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then

			local friend = false

			pcall(function()
				friend = player:IsFriendsWith(p.UserId)
			end)

			table.insert(list, {
				player = p,
				friend = friend
			})
		end
	end

	table.sort(list, function(a, b)

		if a.friend ~= b.friend then
			return a.friend
		end

		local an = a.player.DisplayName:lower()
		local bn = b.player.DisplayName:lower()

		return an < bn
	end)

	for _, item in ipairs(list) do

		local target = item.player

		local card = Instance.new("Frame")
		card.Size = UDim2.new(1, -5, 0, 125)
		card.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
