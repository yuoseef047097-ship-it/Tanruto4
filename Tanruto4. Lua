local function refreshSuggestions()

	clearSuggestions()

	if #suggestions==0 then
		local empty=Instance.new("TextLabel")
		empty.Size=UDim2.new(1,-10,0,50)
		empty.BackgroundTransparency=1
		empty.Text="لا توجد اقتراحات حالياً"
		empty.TextColor3=Color3.fromRGB(160,160,160)
		empty.TextSize=11
		empty.Parent=suggestionScroll
		return
	end

	table.sort(suggestions,function(a,b)
		return ((a.yes or 0)-(a.no or 0))>
			((b.yes or 0)-(b.no or 0))
	end)

	for _,data in ipairs(suggestions) do
		createSuggestionCard(data)
	end
end

