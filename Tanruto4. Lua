-- PLAYER EVENTS
--------------------------------------------------

connect(Players.PlayerAdded, function()
	task.wait(0.2)

	if not gui.Parent then
		return
	end

	if playersWindow.Visible then
		refreshPlayers()
	end

	if states.espAll then
		refreshAllESP()
	end
end)

connect(Players.PlayerRemoving, function(target)
	removeESP(target)

	selectedESP[target] = nil

	if targetPlayer == target then
		stopSpectating()
	end

	if playersWindow.Visible then
		refreshPlayers()
	end
end)

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

connect(player.CharacterAdded, function(character)
	task.wait(0.35)

	if not character.Parent then
		return
	end

	if states.flying then
		stopFly()
	end

	restoreNoclip()

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.WalkSpeed =
			speedList[speedIndex]

		humanoid.UseJumpPower = true

		humanoid.JumpPower =
			jumpList[jumpIndex]

		humanoid.AutoJumpEnabled =
			states.autoJump

		if states.hideName then
			humanoid.DisplayDistanceType =
				Enum.HumanoidDisplayDistanceType.None
		else
			humanoid.DisplayDistanceType =
				Enum.HumanoidDisplayDistanceType.Viewer
		end
	end

	if states.noclip then
		setNoclip(true)
	end

	if states.godMode then
		startGod()
	end

	if states.spectating then
		stopSpectating()
	end

	safePosition = nil

	if states.antiFall then
		local root = getRoot()

		if root then
			safePosition = root.CFrame
		end
	end

	if states.espAll then
		task.wait(0.2)

		if states.espAll then
			refreshAllESP()
		end
	end

	applyFOV()
end)

