--------------------------------------------------
-- PLAYER ESP FUNCTIONS
--------------------------------------------------

local function removePlayerESP(target)
	if selectedESP[target] then
		selectedESP[target]:Destroy()
		selectedESP[target] = nil
	end

	if espConnections[target] then
		espConnections[target]:Disconnect()
		espConnections[target] = nil
	end
end

local function addPlayerESP(target)
	removePlayerESP(target)

	if not isValidPlayer(target) then
		return false
	end

	if not target.Character then
		return false
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "T4_SelectedESP"
	highlight.Adornee = target.Character
	highlight.FillColor = themes[currentTheme]
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.2
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = target.Character

	selectedESP[target] = highlight

	espConnections[target] = target.CharacterAdded:Connect(function(char)
		task.wait(0.3)

		if selectedESP[target] then
			selectedESP[target].Adornee = char
			selectedESP[target].Parent = char
			selectedESP[target].FillColor = themes[currentTheme]
		end
	end)

	return true
end

local function togglePlayerESP(target, espButtonObject)
	if selectedESP[target] then
		removePlayerESP(target)
		espButtonObject.Text = "🎯 ESP"
	else
		if addPlayerESP(target) then
			espButtonObject.Text = "🎯 إيقاف ESP"
		end
	end
end

