local function saveCurrentEnvironment()

	savedGlobalShadows = Lighting.GlobalShadows
	savedBrightness = Lighting.Brightness

	pcall(function()
		savedQualityLevel =
			settings().Rendering.QualityLevel
	end)

	table.clear(savedPostEffects)

	for _, obj in ipairs(Lighting:GetChildren()) do
		if obj:IsA("PostEffect") then
			savedPostEffects[obj] = obj.Enabled
		end
	end
end

local function restoreEnvironment()

	Lighting.GlobalShadows =
		savedGlobalShadows

	Lighting.Brightness =
		savedBrightness

	pcall(function()
		if savedQualityLevel then
			settings().Rendering.QualityLevel =
				savedQualityLevel
		else
			settings().Rendering.QualityLevel =
				Enum.QualityLevel.Automatic
		end
	end)

	for obj, state in pairs(savedPostEffects) do
		if obj and obj.Parent then
			obj.Enabled = state
		end
	end
end

local function setLowQuality(enabled)

	if enabled == lowQuality then
		return
	end

	if enabled then

		saveCurrentEnvironment()

		lowQuality = true

		Lighting.GlobalShadows = false
		Lighting.Brightness = 1

		pcall(function()
			settings().Rendering.QualityLevel =
				Enum.QualityLevel.Level01
		end)

		for _, obj in ipairs(Lighting:GetChildren()) do

			if obj:IsA("PostEffect") then
				obj.Enabled = false

			elseif obj:IsA("Atmosphere") then
				obj.Density = 0
				obj.Haze = 0
				obj.Glare = 0
			end
		end

		lowQualityButton.Text =
			"🎮 تقليل الجودة: تشغيل"

	else

		lowQuality = false
		restoreEnvironment()

		lowQualityButton.Text =
			"🎮 تقليل الجودة: إيقاف"
	end
end

lowQualityButton.MouseButton1Click:Connect(function()
	setLowQuality(not lowQuality)
end)

