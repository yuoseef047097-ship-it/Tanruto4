	end
end

local function restorePerformanceStates()

	Lighting.GlobalShadows =
		savedGlobalShadows

	Lighting.Brightness =
		savedBrightness

	pcall(function()
		if savedQualityLevel then
			settings().Rendering.QualityLevel =
				savedQualityLevel
		end
	end)

	for obj, state in pairs(
		savedPostEffects
	) do

		if obj and obj.Parent then
			obj.Enabled = state
		end
	end

	for obj, state in pairs(
		savedParticleStates
	) do

		if obj and obj.Parent then
			obj.Enabled = state
		end
	end

	table.clear(savedPostEffects)
	table.clear(savedParticleStates)
end

local function optimizeObject(obj)

	if obj:IsA("BasePart") then
		obj.CastShadow = false
	elseif obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		if savedParticleStates[obj] == nil then
			savedParticleStates[obj] =
				obj.Enabled
		end

		obj.Enabled = false
	end
end

local function setFPSBoost(enabled)

	if enabled == states.fpsBoost then
		return
	end

	if enabled then

		savePerformanceStates()

		states.fpsBoost = true

		pcall(function()
			settings().Rendering.QualityLevel =
				Enum.QualityLevel.Level01
		end)

		Lighting.GlobalShadows = false

		for _, obj in ipairs(workspace:GetDescendants()) do
			optimizeObject(obj)
		end

		for _, obj in ipairs(
			Lighting:GetChildren()
		) do

			if obj:IsA("PostEffect") then

				if savedPostEffects[obj] == nil then
					savedPostEffects[obj] =
						obj.Enabled
				end

				obj.Enabled = false
			end
		end

	else

		states.fpsBoost = false
		restorePerformanceStates()

	end

	fpsBoostButton.Text =
		states.fpsBoost
		and "⚡ FPS Boost: تشغيل"
		or "⚡ FPS Boost: إيقاف"
end

fpsBoostButton.MouseButton1Click:Connect(function()
	setFPSBoost(
		not states.fpsBoost
	)
end)

workspace.DescendantAdded:Connect(function(obj)

