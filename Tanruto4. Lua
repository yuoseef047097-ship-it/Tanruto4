local function restoreNoclip()
	for part, oldValue in pairs(savedPartCollisions) do
		if part and part.Parent then
			part.CanCollide = oldValue
		end
	end

	table.clear(savedPartCollisions)
end

local function setNoclip(enabled)

	noclip = enabled

	if enabled then

		local char = getCharacter()

		if char then
			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("BasePart") then

					if savedPartCollisions[obj] == nil then
						savedPartCollisions[obj] = obj.CanCollide
					end

					obj.CanCollide = false
				end
			end
		end

	else
		restoreNoclip()
	end

	noclipButton.Text =
		noclip
		and "نوكلب: تشغيل"
		or "نوكلب: إيقاف"
end

