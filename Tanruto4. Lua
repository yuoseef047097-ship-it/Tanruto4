local function removeESP(target)
	local data = espObjects[target]

	if not data then
		return
	end

	if data.highlight then
		pcall(function()
			data.highlight:Destroy()
		end)
	end

	if data.billboard then
		pcall(function()
			data.billboard:Destroy()
		end)
	end

	if data.healthConnection then
		pcall(function()
			data.healthConnection:Disconnect()
		end)
	end

	if data.characterConnection then
		pcall(function()
			data.characterConnection:Disconnect()
		end)
	end

	espObjects[target] = nil
end

local function shouldShowESP(target)
	if not isValidPlayer(target) then
		return false
	end

	if not target.Character then
		return false
	end

	if states.teamCheck
		and player.Team
		and target.Team
		and player.Team == target.Team then
		return false
	end

	return true
end

local function createESP(target, selected)
	removeESP(target)

	if not shouldShowESP(target) then
		return false
	end

	local character = target.Character

	if not character then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = selected and "T4_SelectedESP" or "T4_ESP"
	highlight.Adornee = character
	highlight.FillColor = themes[currentTheme]
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = selected and 0.18 or 0.45
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "T4_ESPInfo"
	billboard.Size = UDim2.fromOffset(190, 72)
	billboard.StudsOffset = Vector3.new(0, 3.2, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 1000
	billboard.Adornee = root
	billboard.Parent = root

	local info = Instance.new("TextLabel")
	info.Size = UDim2.fromScale(1, 1)
	info.BackgroundTransparency = 1
	info.TextColor3 = Color3.new(1, 1, 1)
	info.TextStrokeTransparency = 0
	info.TextSize = 11
	info.Font = Enum.Font.GothamBold
	info.TextWrapped = true
	info.Parent = billboard

	local data = {
		highlight = highlight,
		billboard = billboard,
		info = info,
		humanoid = humanoid,
		root = root,
		characterConnection = nil,
		healthConnection = nil
	}

	espObjects[target] = data

	local function updateInfo()
		if not data.info or not data.info.Parent then
			return
		end

		local lines = {}

		if states.espNames then
			table.insert(
				lines,
				target.DisplayName .. "  @" .. target.Name
			)
		end

		if states.espDistance then
			local localRoot = getRoot()

			if localRoot
				and data.root
				and data.root.Parent then

				local distance = math.floor(
					(localRoot.Position - data.root.Position).Magnitude
				)

				table.insert(
					lines,
					"📏 " .. tostring(distance) .. "m"
				)
			end
		end

		if states.espHealth and data.humanoid then
			local health = math.max(
				0,
				math.floor(data.humanoid.Health)
			)

			local maxHealth = math.max(
				1,
				math.floor(data.humanoid.MaxHealth)
			)

			table.insert(
				lines,
				"❤ " .. tostring(health) .. "/" .. tostring(maxHealth)
			)
		end

		data.info.Text = table.concat(lines, "\n")

		data.info.Visible =
			states.espNames
			or states.espDistance
			or states.espHealth
	end

	updateInfo()

	if humanoid then
		data.healthConnection = humanoid.HealthChanged:Connect(
			updateInfo
		)
	end

	data.characterConnection = target.CharacterAdded:Connect(
		function()
			task.wait(0.2)

			if target.Parent ~= Players then
				return
			end

			local useSelected =
				selectedESP[target] == true

			if states.espAll or useSelected then
				createESP(target, useSelected)
			end
		end
	)

	data.updateInfo = updateInfo

	return true
end

