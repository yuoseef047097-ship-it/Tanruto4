local function getRequest()
	return request
		or http_request
		or (syn and syn.request)
		or (fluxus and fluxus.request)
end

local function discordRequest(data)
	if not DISCORD_WEBHOOK
		or DISCORD_WEBHOOK == ""
		or DISCORD_WEBHOOK == "https://discord.com/api/webhooks/1542135413597274224/"https://discord.com/api/webhooks/1542150710420963429/bi2t8xuAe3iyYi40iQPFybUwLBp9DOIaHyUX08P8bZW8UCqeN1Hp943lTtdFHsTPTC4m" then
		return false
	end

	local req = getRequest()
	if not req then
		return false
	end

	local ok, body = pcall(function()
		return HttpService:JSONEncode(data)
	end)

	if not ok then
		return false
	end

	local success = pcall(function()
		req({
			Url = DISCORD_WEBHOOK,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = body
		})
	end)

	return success
end

