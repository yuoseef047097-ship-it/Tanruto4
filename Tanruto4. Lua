--------------------------------------------------

local function trim(text)
	text = tostring(text or "")
	text = text:gsub("^%s+", "")
	text = text:gsub("%s+$", "")
	return text
end

local function getCharacter()
	return player.Character
end

local function getHumanoid()
	local char = getCharacter()
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local char = getCharacter()
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getNextTPName()
	local name = "نقطة انتقال " .. nextTPNumber
	nextTPNumber += 1
	return name
end

local function findPlayer(text)
	text = trim(text):lower()

	if text == "" then
		return nil
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			if p.Name:lower() == text
				or p.DisplayName:lower() == text then
				return p
			end
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			if p.Name:lower():sub(1, #text) == text
				or p.DisplayName:lower():sub(1, #text) == text then
				return p
			end
		end
	end

	return nil
end

local function isValidPlayer(p)
	return p and p.Parent == Players and p ~= player
end

