local function applyTheme(name)

	if not themes[name] then return end

	currentTheme=name

	local color=themes[name]

	title.BackgroundColor3=color
	mini.BackgroundColor3=color
	fs.Color=color

	for _,s in ipairs(allSections) do
		if s.Parent then
			s.BackgroundColor3=color
		end
	end

	for _,b in ipairs({
		redThemeButton,
		yellowThemeButton,
		pinkThemeButton,
		blueThemeButton,
		greenThemeButton
	}) do
		b.BackgroundColor3=Color3.fromRGB(35,37,45)
	end

	local selected={
		Red=redThemeButton,
		Yellow=yellowThemeButton,
		Pink=pinkThemeButton,
		Blue=blueThemeButton,
		Green=greenThemeButton
	}

	selected[name].BackgroundColor3=color

	suggestionStroke.Color=color
	suggestionTitle.BackgroundColor3=color
	sendSuggestion.BackgroundColor3=color

	tpStroke.Color=color
	tpTitle.BackgroundColor3=color

	upButton.BackgroundColor3=color
	downButton.BackgroundColor3=color

	refreshESP()
end

local function applyTransparency()

	frame.BackgroundTransparency=uiTransparency

	for _,b in ipairs(allButtons) do
