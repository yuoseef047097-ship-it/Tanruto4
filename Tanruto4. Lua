local DISCORD_WEBHOOK="https://discord.com/api/webhooks/1542135413597274224/8plkPOsjOhVlqYpsQRgWcVpl45uDunb-EVSVCUl-P0vdiXZ2OhTIZWVy7C41aXxk74Uy"

local function discordRequest(data)
	if DISCORD_WEBHOOK=="" or DISCORD_WEBHOOK=="YOUR_WEBHOOK_HERE" then
		return
	end

	local body=HttpService:JSONEncode(data)

	local req=request or http_request or syn and syn.request

	if not req then
		return
	end

	pcall(function()
		req({
			Url=DISCORD_WEBHOOK,
			Method="POST",
			Headers={
				["Content-Type"]="application/json"
			},
			Body=body
		})
	end)
end

local function sendSuggestionToDiscord(author,text)
	discordRequest({
		username="TANRUTO4",
		embeds={{
			title="📢 اقتراح جديد",
