local savedLighting={}

local function setLowQuality(enabled)
	lowQuality=enabled

	if enabled then
		savedLighting.GlobalShadows=Lighting.GlobalShadows
		savedLighting.Brightness=Lighting.Brightness

		Lighting.GlobalShadows=false
		Lighting.Brightness=1

		pcall(function()
			settings().Rendering.QualityLevel=Enum.QualityLevel.Level01
		end)

		for _,obj in ipairs(Lighting:GetChildren()) do
			if obj:IsA("PostEffect") then
				obj.Enabled=false
			elseif obj:IsA("Atmosphere") then
				obj.Density=0
				obj.Haze=0
				obj.Glare=0
			end
		end

		lowQualityButton.Text="🎮 تقليل الجودة: تشغيل"
	else
		Lighting.GlobalShadows=savedLighting.GlobalShadows~=false
		Lighting.Brightness=savedLighting.Brightness or 2

		pcall(function()
			settings().Rendering.QualityLevel=Enum.QualityLevel.Automatic
		end)

		lowQualityButton.Text="🎮 تقليل الجودة: إيقاف"
	end
end

