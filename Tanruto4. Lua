local function RefreshPlayers()
	for _, child in ipairs(PlayerList:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local query = string.lower(Trim(Search.Text))
	local list = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local name = string.lower(player.Name)
			local display = string.lower(player.DisplayName)

			if query == ""
				or string.find(name, query, 1, true)
				or string.find(display, query, 1, true) then

				local friend = false

				pcall(function()
					friend = LocalPlayer:IsFriendsWith(player.UserId)
				end)

				table.insert(list, {
					Player = player,
					Friend = friend,
				})
			end
		end
	end

	table.sort(list, function(a, b)
		if a.Friend ~= b.Friend then
			return a.Friend
		end

		return string.lower(a.Player.DisplayName)
			< string.lower(b.Player.DisplayName)
	end)

	for _, item in ipairs(list) do
		local player = item.Player

		local card = Instance.new("Frame")
