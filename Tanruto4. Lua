local DashBusy = false

local function DoDash()
	if not State.Dash or DashBusy then
		return
	end

	local root = GetRoot()
	local humanoid = GetHumanoid()
	local camera = GetCamera()

	if not root or not humanoid or not camera then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	local direction = humanoid.MoveDirection

	if direction.Magnitude < 0.05 then
		local look = camera.CFrame.LookVector
		direction = Vector3.new(look.X, 0, look.Z)
	end

	if direction.Magnitude < 0.05 then
		return
	end

	DashBusy = true

	direction = direction.Unit

	local y = math.clamp(root.AssemblyLinearVelocity.Y, -60, 40)

	root.AssemblyLinearVelocity = Vector3.new(
		direction.X * Value.DashPower,
		y,
		direction.Z * Value.DashPower
	)

	Notify("💨 Dash", 0.5)

	task.delay(math.max(Value.DashCooldown, 0.1), function()
		DashBusy = false
	end)
end

Connect(DashButton.Activated, function()
	State.Dash = not State.Dash
