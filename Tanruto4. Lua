local PerformanceBackup = {}
local OriginalGlobalShadows = Lighting.GlobalShadows

local function BackupObject(object)
	if PerformanceBackup[object] then
		return
	end

	if object:IsA("BasePart") then
		PerformanceBackup[object] = {
			Type = "BasePart",
			CastShadow = object.CastShadow,
		}
	elseif object:IsA("ParticleEmitter")
		or object:IsA("Trail")
		or object:IsA("Smoke")
		or object:IsA("Fire")
		or object:IsA("Sparkles") then

		PerformanceBackup[object] = {
			Type = "Enabled",
			Enabled = object.Enabled,
		}
	end
end

local function RestorePerformance()
	for object, data in pairs(PerformanceBackup) do
		if object and object.Parent then
			if data.Type == "BasePart" then
				pcall(function()
					object.CastShadow = data.CastShadow
				end)
			else
				pcall(function()
					object.Enabled = data.Enabled
				end)
			end
		end

		PerformanceBackup[object] = nil
	end

	Lighting.GlobalShadows = State.Shadows
end

local function ApplyPerformance()
	if not State.FPSBoost and not State.LowQuality then
		RestorePerformance()
		return
	end

	Lighting.GlobalShadows = false

	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("BasePart")
			or object:IsA("ParticleEmitter")
			or object:IsA("Trail")
			or object:IsA("Smoke")
			or object:IsA("Fire")
			or object:IsA("Sparkles") then

			BackupObject(object)

			if object:IsA("BasePart") then
				object.CastShadow = false
			else
				object.Enabled = false
			end
		end
	end
end

