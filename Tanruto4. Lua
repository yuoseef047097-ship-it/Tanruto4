--------------------------------------------------
-- FIND PLAYER
--------------------------------------------------

local function findPlayer(text)
	if not text or text=="" then return nil end

	text=text:lower()

	for _,p in ipairs(Players:GetPlayers()) do
		if p~=player and
			(p.Name:lower()==text or p.DisplayName:lower()==text) then
			return p
		end
	end

	for _,p in ipairs(Players:GetPlayers()) do
		if p~=player and
			(p.Name:lower():sub(1,#text)==text
			or p.DisplayName:lower():sub(1,#text)==text) then
			return p
		end
	end

	return nil
end

--------------------------------------------------
-- INDIVIDUAL ESP
--------------------------------------------------

local function removePlayerESP(target)
	if selectedESP[target] then
		selectedESP[target]:Destroy()
		selectedESP[target]=nil
	end

	if espConnections[target] then
		espConnections[target]:Disconnect()
		espConnections[target]=nil
	end
end

local function addPlayerESP(target)
	removePlayerESP(target)

	if not target or not target.Character then
		return false
	end

	local highlight=Instance.new("Highlight")
	highlight.Name="T4_SelectedESP"
	highlight.Adornee=target.Character
	highlight.FillColor=themes[currentTheme]
	highlight.OutlineColor=Color3.new(1,1,1)
	highlight.FillTransparency=.2
	highlight.OutlineTransparency=0
	highlight.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent=target.Character

	selectedESP[target]=highlight

	espConnections[target]=target.CharacterAdded:Connect(function(char)
		task.wait(.5)

		if selectedESP[target] then
			selectedESP[target].Adornee=char
			selectedESP[target].Parent=char
			selectedESP[target].FillColor=themes[currentTheme]
		end
	end)

	return true
end

local function togglePlayerESP(target,b)
	if selectedESP[target] then
		removePlayerESP(target)
		b.Text="🎯 ESP"
	else
		if addPlayerESP(target) then
			b.Text="🎯 إيقاف ESP"
		end
	end
end

