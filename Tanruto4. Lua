local function refreshPlayers()

	for _, child in ipairs(playersScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local list = {}

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then

			local friend = false

			pcall(function()
				friend =
					player:IsFriendsWith(
						target.UserId
					)
			end)

			table.insert(list, {
				player = target,
				friend = friend
			})
		end
	end

	table.sort(list, function(a, b)

		if a.friend ~= b.friend then
			return a.friend
		end

		return
			a.player.DisplayName:lower()
			<
			b.player.DisplayName:lower()
	end)

	for _, item in ipairs(list) do

		local target = item.player

		local card = Instance.new("Frame")
		card.Size = UDim2.new(1, -5, 0, 132)
		card.BackgroundColor3 =
			Color3.fromRGB(30, 32, 40)
		card.BorderSizePixel = 0
		card.ZIndex = 32
		card.Parent = playersScroll

		Instance.new("UICorner", card)
			.CornerRadius = UDim.new(0, 9)

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, -10, 0, 25)
		nameLabel.Position = UDim2.fromOffset(5, 4)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text =
			target.DisplayName ..
			"  @" ..
			target.Name ..
			(item.friend and "  ⭐ صديق" or "")
		nameLabel.TextColor3 = Color3.new(1, 1, 1)
		nameLabel.TextSize = 10
