		title.TextSize = 9
		title.Font = Enum.Font.GothamBold
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.TextTruncate = Enum.TextTruncate.AtEnd
		title.Parent = card

		local TP = CreateButton(card, "📍 TP", 27)
		TP.Size = UDim2.new(0.3, -3, 0, 27)
		TP.Position = UDim2.fromOffset(3, 29)

		local Spectate = CreateButton(card, "👁", 27)
