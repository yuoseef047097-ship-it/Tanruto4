local function findPlayer(text)

	if not text or text=="" then return nil end

	text=text:lower()

	for _,p in ipairs(Players:GetPlayers()) do
		if p~=player and
			(p.Name:lower()==text or p.DisplayName:lower()==text) then
			return p
		end
	end

	for _,p in ipairs(Players:GetPlayers()) do
		if p~=player and
			(p.Name:lower():sub(1,#text)==text or
			p.DisplayName:lower():sub(1,#text)==text) then
			return p
		end
	end

	return nil
end

