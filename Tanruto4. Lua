		RunService.Heartbeat:Connect(
			function()

				local root = getRoot()

				if not root then
					return
				end

				local y =
					root.Position.Y

				if y > -20 then
					safePosition =
						root.CFrame
				end

				if y < -100 then

					if safePosition then
						root.CFrame =
							safePosition
							+ Vector3.new(
								0,
								5,
								0
							)

						root.AssemblyLinearVelocity =
							Vector3.zero
					end
				end
			end
		)

	antiFallButton.Text =
		"🪂 منع السقوط: تشغيل"
