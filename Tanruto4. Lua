--------------------------------------------------
-- RE-EXECUTION CLEANUP
--------------------------------------------------

local function cleanupT4()
	states.flying = false
	states.godMode = false
	states.antiFall = false
	states.noclip = false
	states.spectating = false

	upHeld = false
	downHeld = false

	if flyConnection then
		pcall(function()
			flyConnection:Disconnect()
		end)

		flyConnection = nil
	end

	if flyVelocity then
		pcall(function()
			flyVelocity:Destroy()
		end)

		flyVelocity = nil
	end

	if flyAttachment then
		pcall(function()
			flyAttachment:Destroy()
		end)

		flyAttachment = nil
	end

	if godConnection then
		pcall(function()
			godConnection:Disconnect()
		end)

		godConnection = nil
	end

	if godHealthConnection then
		pcall(function()
			godHealthConnection:Disconnect()
		end)

		godHealthConnection = nil
	end

	if antiFallConnection then
		pcall(function()
			antiFallConnection:Disconnect()
		end)

		antiFallConnection = nil
	end

	restoreNoclip()

	if performanceSnapshot then
		restorePerformance()
	end

	for target in pairs(espObjects) do
		removeESP(target)
	end

	disconnectAll()

	pcall(function()
		if gui and gui.Parent then
			gui:Destroy()
		end
	end)
end

_G.__T4Cleanup = cleanupT4
