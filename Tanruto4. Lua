--------------------------------------------------
-- ESP CREATION
--------------------------------------------------

local function removeESP(target)
	local data = espObjects[target]

	if data then
		if data.highlight then
			data.highlight:Destroy()
		end

		if data.billboard then
			data.billboard:Destroy()
		end

		if data.healthConnection then
			data.healthConnection:Disconnect()
		end

		if data.characterConnection then
			data.characterConnection:Disconnect()
		end

		espObjects[target] = nil
	end
end

local function shouldShowESP(target)
	if not isValidPlayer(target) then
		return false
	end

	if not target.Character then
		return false
	end

	if states.teamCheck
		and player.Team
		and target.Team
		and player.Team == target.Team then
		return false
	end

	return true
end

local function createESP(target, selected)
	removeESP(target)

	if not shouldShowESP(target) then
		return false
	end

	local char = target.Character
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = selected and "T4_SelectedESP" or "T4_ESP"
	highlight.Adornee = char
	highlight.FillColor = themes[currentTheme]
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = selected and 0.18 or 0.45
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = char

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "T4_ESPInfo"
	billboard.Size = UDim2.fromOffset(180, 70)
	billboard.StudsOffset = Vector3.new(0, 3.2, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 1000
	billboard.Adornee = root
	billboard.Parent = root

	local info = Instance.new("TextLabel")
	info.Size = UDim2.fromScale(1, 1)
	info.BackgroundTransparency = 1
	info.TextColor3 = Color3.new(1, 1, 1)
	info.TextStrokeTransparency = 0
	info.TextSize = 11
	info.Font = Enum.Font.GothamBold
	info.TextWrapped = true
	info.Parent = billboard

	local data = {
		highlight = highlight,
		billboard = billboard,
		info = info,
		healthConnection = nil,
		characterConnection = nil
	}

	espObjects[target] = data

	local function updateInfo()
		if not data.info or not data.info.Parent then
			return
		end

		local lines = {}

		if states.espNames then
			table.insert(
				lines,
				target.DisplayName .. "  @" .. target.Name
			)
		end

		if states.espDistance then
			local localRoot = getRoot()

			if localRoot and root and root.Parent then
				local distance =
					math.floor(
						(localRoot.Position - root.Position).Magnitude
					)

				table.insert(
					lines,
					"📏 " .. distance .. "m"
				)
			end
		end

		if states.espHealth and humanoid then
			local hp = math.max(
				0,
				math.floor(humanoid.Health)
			)

			local maxHp = math.max(
				1,
				math.floor(humanoid.MaxHealth)
			)

			table.insert(
				lines,
				"❤ " .. hp .. "/" .. maxHp
			)
		end

		data.info.Text = table.concat(lines, "\n")
		data.info.Visible =
			states.espNames
			or states.espDistance
			or states.espHealth
	end

	updateInfo()

	if humanoid then
		data.healthConnection =
			humanoid.HealthChanged:Connect(updateInfo)
	end

	data.characterConnection =
		target.CharacterAdded:Connect(function()
			task.wait(0.35)

			if espObjects[target] then
				local useSelected =
					selectedESP[target] ~= nil

				createESP(target, useSelected)
			end
		end)

	return true
end

local function refreshAllESP()
	for target in pairs(espObjects) do
		removeESP(target)
	end

	if not states.espAll then
		return
	end

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			createESP(target, false)
		end
	end
end

local function setSelectedESP(target, enabled)
	if not isValidPlayer(target) then
		return
	end

	if enabled then
		if createESP(target, true) then
			selectedESP[target] = true
		end
	else
		selectedESP[target] = nil

		if states.espAll then
			createESP(target, false)
		else
			removeESP(target)
		end
	end
end

