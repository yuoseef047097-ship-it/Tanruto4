local function stopFly()
	states.flying = false

	upHeld = false
	downHeld = false

	flightControls.Visible = false

	if flyConnection then
		pcall(function()
			flyConnection:Disconnect()
		end)

		flyConnection = nil
	end

	if flyVelocity then
		pcall(function()
			flyVelocity:Destroy()
		end)

		flyVelocity = nil
	end

	if flyAttachment then
		pcall(function()
			flyAttachment:Destroy()
		end)

		flyAttachment = nil
	end

	local humanoid = getHumanoid()
	local root = getRoot()

	if humanoid then
		humanoid.AutoRotate = true
	end

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end

	flyButton.Text = "✈ الطيران: إيقاف"
end

local function startFly()
	if states.flying then
		return
	end

	local humanoid = getHumanoid()
	local root = getRoot()

	if not humanoid or not root then
		return
	end

	states.flying = true
	flightControls.Visible = true

	humanoid.AutoRotate = false

	flyAttachment = Instance.new("Attachment")
	flyAttachment.Name = "T4_FlyAttachment"
	flyAttachment.Parent = root

	flyVelocity = Instance.new("LinearVelocity")
	flyVelocity.Name = "T4_FlyVelocity"
	flyVelocity.Attachment0 = flyAttachment
	flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	flyVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	flyVelocity.ForceLimitsEnabled = false
	flyVelocity.VectorVelocity = Vector3.zero
	flyVelocity.Parent = root

	flyConnection = RunService.RenderStepped:Connect(
		function()
			if not states.flying then
				return
			end

			local currentHumanoid = getHumanoid()
			local currentRoot = getRoot()
			local camera = getCamera()

			if not currentHumanoid
				or not currentRoot
				or not camera then

				stopFly()
				return
			end

			local move = currentHumanoid.MoveDirection

			if UIS:IsKeyDown(Enum.KeyCode.W) then
				move += camera.CFrame.LookVector
			end

			if UIS:IsKeyDown(Enum.KeyCode.S) then
				move -= camera.CFrame.LookVector
			end

			if UIS:IsKeyDown(Enum.KeyCode.A) then
				move -= camera.CFrame.RightVector
			end

			if UIS:IsKeyDown(Enum.KeyCode.D) then
				move += camera.CFrame.RightVector
			end

			if upHeld
				or UIS:IsKeyDown(Enum.KeyCode.Space) then
				move += Vector3.new(0, 1, 0)
			end

			if downHeld
				or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
				move -= Vector3.new(0, 1, 0)
			end

			if move.Magnitude > 0 then
				flyVelocity.VectorVelocity =
					move.Unit * flySpeed
			else
				flyVelocity.VectorVelocity =
					Vector3.zero
			end
		end
	)

	flyButton.Text = "✈ الطيران: تشغيل"
end

connect(flyButton.Activated, function()
	if states.flying then
		stopFly()
	else
		startFly()
	end
end)

