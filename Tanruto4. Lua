		spec.Position = UDim2.new(0.34, 0, 0, 35)
		spec.Text = "👁 مشاهدة"
		spec.TextColor3 = Color3.new(1, 1, 1)
		spec.TextSize = 10
		spec.BackgroundColor3 = Color3.fromRGB(65, 67, 75)
		spec.ZIndex = 33
		spec.Parent = card

		local esp = Instance.new("TextButton")
		esp.Size = UDim2.new(0.32, -5, 0, 34)
		esp.Position = UDim2.new(0.68, 0, 0, 35)
		esp.Text = selectedESP[target]
			and "🎯 إيقاف ESP"
			or "🎯 ESP"
		esp.TextColor3 = Color3.new(1, 1, 1)
		esp.TextSize = 10
		esp.BackgroundColor3 = Color3.fromRGB(125, 75, 180)
		esp.ZIndex = 33
