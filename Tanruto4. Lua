--------------------------------------------------

local function decodeServerBody(body)
	if typeof(body) ~= "string"
		or body == "" then
		return nil
	end

	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(body)
	end)

	if ok and type(decoded) == "table" then
		return decoded
	end

	return nil
end

local function getPublicServers()
	local url =
		"https://games.roblox.com/v1/games/"
		.. tostring(game.PlaceId)
		.. "/servers/Public?sortOrder=Asc&limit=100"

	local requestFunction = getRequest()

	if requestFunction then
		local ok, response = pcall(function()
			return requestFunction({
				Url = url,
				Method = "GET"
			})
		end)

		if ok and response then
			local body

			pcall(function()
				body = response.Body or response.body
			end)

			local decoded =
				decodeServerBody(body)

			if decoded then
				return decoded
			end
		end
	end

	local gameHttpGet

	pcall(function()
		gameHttpGet = game.HttpGet
	end)

	if typeof(gameHttpGet) == "function" then
		local ok, body = pcall(function()
			return game:HttpGet(url)
		end)

		if ok then
			local decoded =
				decodeServerBody(body)

			if decoded then
				return decoded
			end
		end
	end

	return nil
end

connect(serverHopButton.Activated, function()
	serverHopButton.Text =
		"🌐 البحث عن سيرفر..."

	local data = getPublicServers()

	if not data
		or type(data.data) ~= "table" then

		serverHopButton.Text =
			"❌ تعذر العثور"

		task.delay(1.5, function()
			if serverHopButton.Parent then
				serverHopButton.Text =
					"🌐 Server Hop"
			end
		end)

		return
	end

	local candidates = {}

	for _, server in ipairs(data.data) do
		if type(server) == "table"
			and typeof(server.id) == "string"
			and server.id ~= ""
			and server.id ~= game.JobId then

			local playing = tonumber(server.playing)
			local maxPlayers = tonumber(server.maxPlayers)

			if not playing
				or not maxPlayers
				or playing < maxPlayers then

				table.insert(
					candidates,
					server.id
				)
			end
		end
	end

	if #candidates == 0 then
		serverHopButton.Text =
			"❌ لا يوجد سيرفر"

		task.delay(1.5, function()
			if serverHopButton.Parent then
				serverHopButton.Text =
					"🌐 Server Hop"
			end
		end)

		return
	end

	local selectedJob =
		candidates[
			math.random(1, #candidates)
		]

	serverHopButton.Text =
		"🚀 انتقال..."

	teleportToServer(
		game.PlaceId,
		selectedJob
	)

	task.delay(2, function()
		if serverHopButton.Parent then
			serverHopButton.Text =
				"🌐 Server Hop"
		end
	end)
end)

