--------------------------------------------------
-- PERFORMANCE HELPERS
--------------------------------------------------

local function isVisualEffect(object)
	return object:IsA("ParticleEmitter")
		or object:IsA("Trail")
		or object:IsA("Beam")
		or object:IsA("Smoke")
		or object:IsA("Fire")
		or object:IsA("Sparkles")
end

local function capturePerformance()
	if performanceSnapshot then
		return
	end

	performanceSnapshot = {
		globalShadows = Lighting.GlobalShadows,
		brightness = Lighting.Brightness,
		qualityLevel = nil,
		particles = {},
		castShadows = {},
		postEffects = {},
		atmospheres = {}
	}

	pcall(function()
		performanceSnapshot.qualityLevel =
			settings().Rendering.QualityLevel
	end)

	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("BasePart") then
			performanceSnapshot.castShadows[object] =
				object.CastShadow
		elseif isVisualEffect(object) then
			performanceSnapshot.particles[object] =
				object.Enabled
		end
	end

	for _, object in ipairs(Lighting:GetChildren()) do
		if object:IsA("PostEffect") then
			performanceSnapshot.postEffects[object] =
				object.Enabled

		elseif object:IsA("Atmosphere") then
			performanceSnapshot.atmospheres[object] = {
				Density = object.Density,
				Haze = object.Haze,
				Glare = object.Glare,
				Offset = object.Offset
			}
		end
	end
end

local function restorePerformance()
	if not performanceSnapshot then
		return
	end

	Lighting.GlobalShadows =
		performanceSnapshot.globalShadows

	Lighting.Brightness =
		performanceSnapshot.brightness

	pcall(function()
		if performanceSnapshot.qualityLevel then
			settings().Rendering.QualityLevel =
				performanceSnapshot.qualityLevel
		end
	end)

	for object, value in pairs(
		performanceSnapshot.castShadows
	) do
		if object and object.Parent then
			pcall(function()
				object.CastShadow = value
			end)
		end
	end

	for object, value in pairs(
		performanceSnapshot.particles
	) do
		if object and object.Parent then
			pcall(function()
				object.Enabled = value
			end)
		end
	end

	for object, value in pairs(
		performanceSnapshot.postEffects
	) do
		if object and object.Parent then
			pcall(function()
				object.Enabled = value
			end)
		end
	end

	for object, value in pairs(
		performanceSnapshot.atmospheres
	) do
		if object and object.Parent then
			pcall(function()
				object.Density = value.Density
				object.Haze = value.Haze
				object.Glare = value.Glare
				object.Offset = value.Offset
			end)
		end
	end

	performanceSnapshot = nil

	Lighting.GlobalShadows =
		states.shadowsEnabled

	for _, object in ipairs(workspace:GetDescendants()) do
		if isVisualEffect(object) then
			pcall(function()
				object.Enabled = states.particlesEnabled
			end)
		end
	end
end

local function applyPerformance()
	local active =
		states.fpsBoost
		or states.lowQuality

	if not active then
		restorePerformance()
		return
	end

	capturePerformance()

	pcall(function()
		settings().Rendering.QualityLevel =
			Enum.QualityLevel.Level01
	end)

	Lighting.GlobalShadows = false

	if states.lowQuality then
		Lighting.Brightness = 1
	end

	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("BasePart") then
			pcall(function()
				object.CastShadow = false
			end)

		elseif isVisualEffect(object) then
			pcall(function()
				object.Enabled = false
			end)
		end
	end

	for _, object in ipairs(Lighting:GetChildren()) do
		if object:IsA("PostEffect") then
			pcall(function()
				object.Enabled = false
			end)

		elseif states.lowQuality
			and object:IsA("Atmosphere") then

			pcall(function()
				object.Density = 0
				object.Haze = 0
				object.Glare = 0
				object.Offset = 0
			end)
		end
	end
end

