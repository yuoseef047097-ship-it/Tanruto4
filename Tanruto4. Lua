local function setFPSBoost(enabled)

	if enabled == fpsBoost then
		return
	end

	if enabled then

		if not lowQuality then
			saveCurrentEnvironment()
		end

		fpsBoost = true

		pcall(function()
			settings().Rendering.QualityLevel =
				Enum.QualityLevel.Level01
		end)

		Lighting.GlobalShadows = false

		for _, obj in ipairs(workspace:GetDescendants()) do

			if obj:IsA("BasePart") then
				obj.CastShadow = false

			elseif obj:IsA("ParticleEmitter")
				or obj:IsA("Trail")
				or obj:IsA("Beam")
				or obj:IsA("Smoke")
				or obj:IsA("Fire")
				or obj:IsA("Sparkles") then

				if savedParticleStates[obj] == nil then
					savedParticleStates[obj] = obj.Enabled
				end

				obj.Enabled = false
			end
		end

		for _, obj in ipairs(Lighting:GetChildren()) do
			if obj:IsA("PostEffect") then

				if savedPostEffects[obj] == nil then
					savedPostEffects[obj] = obj.Enabled
				end

				obj.Enabled = false
			end
		end

		fpsBoostButton.Text =
			"⚡ رفع الفريمات: تشغيل"

	else

		fpsBoost = false

		for obj, state in pairs(savedParticleStates) do
			if obj and obj.Parent then
				obj.Enabled = state
			end
		end

		table.clear(savedParticleStates)

		for obj, state in pairs(savedPostEffects) do
			if obj and obj.Parent then
				obj.Enabled = state
			end
		end

		pcall(function()
			if savedQualityLevel then
				settings().Rendering.QualityLevel =
					savedQualityLevel
			else
				settings().Rendering.QualityLevel =
					Enum.QualityLevel.Automatic
			end
		end)

		fpsBoostButton.Text =
			"⚡ رفع الفريمات: إيقاف"

	end
end

