		or "🧱 Wall Hop: إيقاف"
end)

Connect(UIS.JumpRequest, function()
	if not State.WallHop then
		return
	end

	if os.clock() - LastWallHop < 0.18 then
		return
	end

	local root = GetRoot()
	local humanoid = GetHumanoid()

	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	local wall = FindWall()

	if not wall then
		return
	end

	LastWallHop = os.clock()

	root.AssemblyLinearVelocity =
		wall.Normal * Value.WallHopSpeed
		+ Vector3.new(0, Value.WallHopPower, 0)

	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
end)

