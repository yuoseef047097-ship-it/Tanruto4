--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function trim(text)
	text = tostring(text or "")
	text = text:gsub("^%s+", "")
	text = text:gsub("%s+$", "")
	return text
end

local function getCharacter()
	return player.Character
end

local function getHumanoid()
	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function isValidPlayer(target)
	return target
		and target ~= player
		and target.Parent == Players
end

local function getNextTPName()
	local name = "نقطة انتقال " .. tostring(nextTPNumber)
	nextTPNumber += 1
	return name
end

local function findPlayer(text)
	text = trim(text):lower()

	if text == "" then
		return nil
	end

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			if target.Name:lower() == text
				or target.DisplayName:lower() == text then
				return target
			end
		end
	end

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			if target.Name:lower():sub(1, #text) == text
				or target.DisplayName:lower():sub(1, #text) == text then
				return target
			end
		end
	end

	return nil
end

--------------------------------------------------
-- CLIPBOARD
--------------------------------------------------

local function safeSetClipboard(text)
	local clipboardFunction = nil

	pcall(function()
		clipboardFunction = setclipboard
	end)

	if typeof(clipboardFunction) == "function" then
		return pcall(function()
			clipboardFunction(tostring(text))
		end)
	end

	local toClipboardFunction = nil

	pcall(function()
		toClipboardFunction = toclipboard
	end)

	if typeof(toClipboardFunction) == "function" then
		return pcall(function()
			toClipboardFunction(tostring(text))
		end)
	end

	local clipboardObject = nil

	pcall(function()
		clipboardObject = Clipboard
	end)

	if clipboardObject then
		local setFunction

		pcall(function()
			setFunction = clipboardObject.set
		end)

		if typeof(setFunction) == "function" then
			return pcall(function()
				setFunction(tostring(text))
			end)
		end
	end

	return false
end

