Connect(RunService.RenderStepped, function()
	if not State.Fly then
		return
	end

	local root = GetRoot()
	local humanoid = GetHumanoid()
	local camera = GetCamera()

	if not root or not humanoid or not camera or not FlyVelocity then
		StopFly()
		return
	end

	local move = humanoid.MoveDirection
	local direction = Vector3.new(move.X, 0, move.Z)

	local vertical = 0

	if UIS:IsKeyDown(Enum.KeyCode.Space) then
		vertical += 1
	end

	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
		vertical -= 1
	end

	if State.FlyUp then
		vertical += 1
	end

	if State.FlyDown then
		vertical -= 1
	end

	direction += Vector3.new(0, vertical, 0)

	if direction.Magnitude > 0.01 then
		FlyVelocity.VectorVelocity = direction.Unit * Value.FlySpeed
	else
		FlyVelocity.VectorVelocity = Vector3.zero
	end

	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)

	if flat.Magnitude > 0.01 and FlyOrientation then
		FlyOrientation.CFrame =
			CFrame.lookAt(root.Position, root.Position + flat.Unit)
	end
end)

