Connect(RunService.Heartbeat, function()
	local localRoot = GetRoot()

	if TracerPart and TracerPart.Parent then
		local camera = GetCamera()
		if camera then
			TracerPart.CFrame = camera.CFrame
		end
	end

	for player, data in pairs(ESPObjects) do
		if not player.Parent
			or not data.Root
			or not data.Root.Parent
			or not data.Humanoid
			or not data.Humanoid.Parent then

			RemoveESP(player)
		else
			local lines = {}

			if State.ESPNames then
				table.insert(lines, player.DisplayName .. " @" .. player.Name)
			end

			if State.ESPDistance and localRoot then
				local distance = math.floor(
					(localRoot.Position - data.Root.Position).Magnitude
				)

