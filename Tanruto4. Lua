local function getPublicServers()

	local url =
		"https://games.roblox.com/v1/games/"
		.. tostring(game.PlaceId)
		.. "/servers/Public?sortOrder=Asc&limit=100"

	local req = getRequest()

	if req then

		local ok, result =
			pcall(function()
				return req({
					Url = url,
					Method = "GET"
				})
			end)

		if ok and result then
			local body =
				result.Body
				or result.body

			if body then
				local decodeOk, decoded =
					pcall(function()
						return HttpService:JSONDecode(
							body
						)
					end)

				if decodeOk then
					return decoded
				end
			end
		end
	end

	local httpOk, body =
		pcall(function()
			return game:HttpGet(url)
		end)

	if httpOk and body then

		local decodeOk, decoded =
			pcall(function()
				return HttpService:JSONDecode(
					body
				)
			end)

		if decodeOk then
			return decoded
		end
	end

	return nil
end

serverHopButton.MouseButton1Click:Connect(function()

	serverHopButton.Text =
		"🌐 البحث عن سيرفر..."

	local data =
		getPublicServers()

	if not data
		or not data.data then

		serverHopButton.Text =
			"❌ تعذر العثور"

		task.delay(1.5, function()
			if serverHopButton.Parent then
				serverHopButton.Text =
					"🌐 Server Hop"
			end
		end)

		return
	end

	local candidates = {}

	for _, server in ipairs(
		data.data
	) do

		if server.id
			and server.id ~= game.JobId
			and (
				not server.maxPlayers
				or not server.playing
				or server.playing <
					server.maxPlayers
			) then

			table.insert(
				candidates,
				server.id
			)
		end
	end

	if #candidates == 0 then

		serverHopButton.Text =
			"❌ لا يوجد سيرفر"

		task.delay(1.5, function()
			if serverHopButton.Parent then
				serverHopButton.Text =
					"🌐 Server Hop"
			end
		end)

		return
	end

	local selectedJob =
		candidates[
			math.random(
				1,
				#candidates
			)
		]

	serverHopButton.Text =
		"🚀 انتقال..."

	pcall(function()
		TeleportService:TeleportToPlaceInstance(
			game.PlaceId,
			selectedJob,
			player
		)
	end)

	task.delay(2, function()
		if serverHopButton.Parent then
			serverHopButton.Text =
				"🌐 Server Hop"
		end
	end)
end)

